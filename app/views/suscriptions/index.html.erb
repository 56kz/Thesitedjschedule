<style>
  body.suscriptions-index { background: #f0ede8 !important; }

  .admin-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 1px 4px rgba(0,0,0,.07), 0 0 0 1px rgba(0,0,0,.04);
    overflow: hidden;
  }
  .admin-card-header {
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .admin-card-title { font-size: 1rem; font-weight: 700; color: #111827; margin: 0; }

  /* Override DataTables + Bootstrap table styles */
  table.dataTable.admin-table,
  table.dataTable.admin-table.no-footer { border-bottom: none !important; }

  table.dataTable.admin-table thead th,
  table.dataTable.admin-table thead td {
    font-size: .65rem !important;
    font-weight: 700 !important;
    letter-spacing: .08em !important;
    text-transform: uppercase !important;
    color: #9ca3af !important;
    border-top: none !important;
    border-bottom: 1px solid #f3f4f6 !important;
    padding: 1rem 1.5rem !important;
    background: #fff !important;
  }

  table.dataTable.admin-table tbody tr.odd,
  table.dataTable.admin-table tbody tr.even,
  table.dataTable.admin-table tbody tr { background-color: #fff !important; }

  table.dataTable.admin-table tbody td {
    padding: 1.1rem 1.5rem !important;
    border-top: 1px solid #f9fafb !important;
    border-left: none !important;
    border-right: none !important;
    vertical-align: middle !important;
    font-size: .88rem !important;
    color: #374151 !important;
  }

  table.dataTable.admin-table tbody tr:last-child td { border-bottom: none !important; }

  .badge-tipo {
    background: #1f2937; color: #fff;
    border-radius: 6px; padding: .2rem .55rem;
    font-size: .72rem; font-weight: 600;
  }
  .badge-activo {
    background: #dcfce7; color: #16a34a;
    border-radius: 6px; padding: .15rem .5rem;
    font-size: .65rem; font-weight: 600;
  }
  .badge-inactivo {
    background: #f3f4f6; color: #9ca3af;
    border-radius: 6px; padding: .15rem .5rem;
    font-size: .65rem;
  }
  .badge-vencido {
    background: #fee2e2; color: #dc2626;
    border-radius: 6px; padding: .15rem .5rem;
    font-size: .65rem; font-weight: 600;
  }
</style>

<div class="container-fluid py-4" style="max-width: 1200px; padding-bottom: 80px;">
  <div class="admin-card">
    <div class="admin-card-header">
      <div class="d-flex align-items-center">
        <%= link_to root_path, class: "btn btn-sm btn-light mr-3", style: "border-radius:8px;" do %>
          <i class="bi bi-arrow-left"></i>
        <% end %>
        <h5 class="admin-card-title">
          <i class="bi bi-credit-card mr-2 text-success"></i>Suscripciones
        </h5>
      </div>
      <%= link_to new_suscription_path, class: "btn btn-sm btn-primary", style: "border-radius:8px;" do %>
        <i class="bi bi-plus-lg"></i> Crear suscripción
      <% end %>
    </div>

    <div class="p-3">
      <div class="table-responsive">
        <table class="table admin-table mb-0">
          <thead>
            <tr>
              <th>Tipo</th>
              <th>Estado</th>
              <th>Horas</th>
              <th>Cabinas</th>
              <th>Factura</th>
              <th>Suscriptor</th>
              <th>Vencimiento</th>
              <th>Observaciones</th>
              <th>Fecha</th>
              <th>Opciones</th>
            </tr>
          </thead>
          <tbody>
            <% @suscriptions.each do |s| %>
              <tr>
                <td><span class="badge-tipo"><%= s.name %></span></td>
                <td>
                  <% if s.status %>
                    <span class="badge-activo">Activo</span>
                  <% else %>
                    <span class="badge-inactivo">Inactivo</span>
                  <% end %>
                </td>
                <td><%= s.hours %></td>
                <td><%= s.rooms %></td>
                <td><%= s.invoice_number %></td>
                <td><strong><%= s.user.name %></strong></td>
                <td>
                  <% if s.expires_at %>
                    <% if s.expired? %>
                      <span class="badge-vencido"><%= s.expires_at.strftime("%d/%m/%Y") %></span>
                    <% else %>
                      <%= s.expires_at.strftime("%d/%m/%Y") %>
                    <% end %>
                  <% else %>
                    <span style="color:#d1d5db;">—</span>
                  <% end %>
                </td>
                <td><%= s.observations %></td>
                <td><%= s.created_at.in_time_zone.strftime("%d/%m/%Y") %></td>
                <td>
                  <div class="btn-group btn-group-sm" role="group">
                    <%= link_to edit_suscription_path(s), class: "btn btn-outline-success", data: { toggle: "tooltip" }, title: "Editar" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to s, method: :delete, data: { confirm: "¿Seguro deseas eliminar la suscripción?", toggle: "tooltip" }, title: "Eliminar", class: "btn btn-outline-danger" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<footer class="fixed-bottom py-2 bg-dark text-center">
  <span class="text-muted small">Powered by <a href="https://56kz.github.io/#contact" target="_blank" class="text-muted">Verzion56</a></span>
</footer>

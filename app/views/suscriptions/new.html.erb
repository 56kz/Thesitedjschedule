<div class="container-fluid py-4" style="max-width: 700px; padding-bottom: 80px;">
  <div class="admin-card">
    <div class="admin-card-header">
      <div class="d-flex align-items-center">
        <%= link_to suscriptions_path, class: "btn btn-sm btn-light mr-3 admin-btn-back" do %>
          <i class="bi bi-arrow-left"></i>
        <% end %>
        <h5 class="admin-card-title">
          <i class="bi bi-credit-card mr-2 text-success"></i>Crear suscripción
        </h5>
      </div>
    </div>

    <div class="admin-form">
      <div class="form-group">
        <label>Usuario</label>
        <select placeholder="Ingrese un nombre..." id="js-data-name" style="width: 100%;"></select>
      </div>
      <div class="form-group">
        <label>Cabinas</label>
        <select id="room-select" name="states[]" multiple="multiple" style="width: 100%;">
          <option value="1">Cabina 1</option>
          <option value="2">Cabina 2</option>
          <option value="3">Cabina 3</option>
          <option value="4">Cabina 4</option>
          <option value="5">Cabina 5</option>
          <option value="6">Cabina 6</option>
          <option value="7">Cabina 7</option>
          <option value="8">Cabina 8</option>
        </select>
      </div>

      <%= form_for @suscription do |s| %>
        <%= s.text_field :user_id, class: "form-control", type: "hidden" %>
        <%= s.text_field :rooms, class: "form-control", type: "hidden" %>

        <div class="form-group">
          <%= s.label :observations, "Observaciones" %>
          <%= s.text_field :observations, class: "form-control", placeholder: "Observaciones (opcional)" %>
        </div>
        <div class="form-group">
          <%= s.label :invoice_number, "Número de factura" %>
          <%= s.text_field :invoice_number, class: "form-control", placeholder: "Número de factura" %>
        </div>
        <div class="form-group">
          <%= s.label :name, "Tipo de suscripción" %>
          <%= s.select :name, Suscription.names.keys, {}, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= s.label :hours, "Horas" %>
          <%= s.select :hours, hours_options_for_select, {}, class: "form-control" %>
        </div>
        <%= render "expires_at_field", s: s %>
        <div class="form-group">
          <div class="custom-control custom-checkbox">
            <%= s.check_box :status, id: "suscription_status", class: "custom-control-input" %>
            <label class="custom-control-label" for="suscription_status" style="font-size:.88rem;font-weight:400;text-transform:none;letter-spacing:0;color:#374151;">Activo</label>
          </div>
        </div>
        <%= s.submit "Crear suscripción", class: "btn btn-primary btn-block mt-3", style: "border-radius:8px;" %>
      <% end %>
    </div>
  </div>
</div>

<footer class="fixed-bottom py-2 bg-dark text-center">
  <span class="text-muted small">Powered by <a href="https://56kz.github.io/#contact" target="_blank" class="text-muted">Verzion56</a></span>
</footer>

<script>
document.addEventListener("turbolinks:load", function () {
  var results = [{ id: "", text: "" }];

  $.ajax({
    type: "GET",
    url: window.location.origin + '/users.json',
    success: function (data) {
      for (var i in data) {
        results.push({ id: data[i].id, text: data[i].name });
      }
      $('#js-data-name').select2({ data: results, placeholder: "Seleccione un usuario..." });
    }
  });

  $('#room-select').select2({ placeholder: "Seleccione una cabina..." });

  $('#js-data-name').on('select2:select', function (e) {
    $("#suscription_user_id").val(e.params.data.id);
  });

  function syncRooms() {
    var ids = $('#room-select').select2('data').map(function(d) { return d.id; });
    $("#suscription_rooms").val(ids.join(","));
  }

  $('#room-select').on('select2:select select2:unselect', syncRooms);
});
</script>

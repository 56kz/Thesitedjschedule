<div class="container-fluid py-4" style="max-width: 700px; padding-bottom: 80px;">
  <div class="admin-card">
    <div class="admin-card-header">
      <div class="d-flex align-items-center">
        <%= link_to users_path, class: "btn btn-sm btn-light mr-3 admin-btn-back" do %>
          <i class="bi bi-arrow-left"></i>
        <% end %>
        <h5 class="admin-card-title">
          <i class="bi bi-key mr-2 text-warning"></i>Cambiar contraseña — <%= @user.name %>
        </h5>
      </div>
    </div>

    <div class="admin-form">
      <% if @student&.errors&.any? %>
        <div class="alert alert-danger rounded-lg mb-4">
          <ul class="mb-0">
            <% @student.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_for @user, url: update_password_user_path(@user), method: :patch do |f| %>
        <div class="form-group">
          <%= label_tag :password, "Nueva contraseña" %>
          <small class="text-muted d-block mb-1">(<%= Devise.password_length.min %> caracteres mínimo)</small>
          <%= password_field_tag :password, nil, class: "form-control form-control-lg", autocomplete: "new-password" %>
        </div>
        <div class="form-group">
          <%= label_tag :password_confirmation, "Confirmar contraseña" %>
          <%= password_field_tag :password_confirmation, nil, class: "form-control form-control-lg", autocomplete: "new-password" %>
        </div>
        <%= submit_tag "Actualizar contraseña", class: "btn btn-primary btn-lg btn-block mt-4", style: "border-radius:8px;" %>
      <% end %>
    </div>
  </div>
</div>

<footer class="fixed-bottom py-2 bg-dark text-center">
  <span class="text-muted small">Powered by <a href="https://56kz.github.io/#contact" target="_blank" class="text-muted">Verzion56</a></span>
</footer>

<div class="container-fluid py-4" style="max-width: 700px; padding-bottom: 80px;">
  <div class="admin-card">
    <div class="admin-card-header">
      <div class="d-flex align-items-center">
        <%= link_to users_path, class: "btn btn-sm btn-light mr-3 admin-btn-back" do %>
          <i class="bi bi-arrow-left"></i>
        <% end %>
        <h5 class="admin-card-title">
          <i class="bi bi-pencil-square mr-2 text-success"></i>Editar usuario
        </h5>
      </div>
    </div>

    <div class="admin-form">
      <%= form_for @user do |u| %>
        <div class="form-group">
          <%= u.label :name, "Nombre" %>
          <%= u.text_field :name, class: "form-control form-control-lg", placeholder: "Nombre completo" %>
        </div>
        <div class="form-group">
          <%= u.label :email, "Email" %>
          <%= u.email_field :email, class: "form-control form-control-lg", placeholder: "correo@ejemplo.com" %>
        </div>
        <div class="form-group">
          <%= u.label :phone, "Celular" %>
          <%= u.text_field :phone, class: "form-control form-control-lg", placeholder: "Número de celular" %>
        </div>
        <div class="form-group">
          <%= u.label :rol, "Rol" %>
          <%= u.select :rol, User.rols.keys, {}, class: "form-control form-control-lg" %>
        </div>
        <%= u.submit "Guardar cambios", class: "btn btn-primary btn-lg btn-block mt-4", style: "border-radius:8px;" %>
      <% end %>
    </div>
  </div>
</div>

<footer class="fixed-bottom py-2 bg-dark text-center">
  <span class="text-muted small">Powered by <a href="https://56kz.github.io/#contact" target="_blank" class="text-muted">Verzion56</a></span>
</footer>

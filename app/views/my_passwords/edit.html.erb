<div class="container-fluid py-4" style="max-width: 700px; padding-bottom: 80px;">
  <div class="admin-card">
    <div class="admin-card-header">
      <div class="d-flex align-items-center">
        <%= link_to root_path, class: "btn btn-sm btn-light mr-3 admin-btn-back" do %>
          <i class="bi bi-arrow-left"></i>
        <% end %>
        <h5 class="admin-card-title">
          <i class="bi bi-key mr-2 text-warning"></i>Cambiar mi contraseña
        </h5>
      </div>
    </div>

    <div class="admin-form">
      <%= form_for(current_student, url: edit_my_password_path, html: { method: :patch }) do |f| %>
        <%= render "devise/shared/error_messages", resource: current_student %>

        <div class="form-group">
          <%= f.label :current_password, "Contraseña actual" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control form-control-lg" %>
        </div>
        <div class="form-group">
          <%= f.label :password, "Nueva contraseña" %>
          <% if @minimum_password_length %>
            <small class="text-muted d-block mb-1">(<%= @minimum_password_length %> caracteres mínimo)</small>
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control form-control-lg" %>
        </div>
        <div class="form-group">
          <%= f.label :password_confirmation, "Confirmar nueva contraseña" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg" %>
        </div>
        <%= f.submit "Actualizar contraseña", class: "btn btn-primary btn-lg btn-block mt-4", style: "border-radius:8px;" %>
      <% end %>
    </div>
  </div>
</div>

<footer class="fixed-bottom py-2 bg-dark text-center">
  <span class="text-muted small">Powered by <a href="https://56kz.github.io/#contact" target="_blank" class="text-muted">Verzion56</a></span>
</footer>
